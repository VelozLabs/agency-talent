# Frontend (safe to expose — anon key is RLS-gated)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------------------------------------------------------------------------
# Server-side ONLY — set these as Supabase secrets, never in the client:
#   supabase secrets set ANTHROPIC_API_KEY=...
#
#   ANTHROPIC_API_KEY      # vision screenshot parser (parse-screenshot)
#   PARSER_MODEL           # default: claude-haiku-4-5  (escape hatch: claude-sonnet-4-6 / claude-opus-4-8)
#   OURA_PAT               # Oura personal access token (oura-sync)
#   APPLE_HEALTH_TOKEN     # shared bearer secret for the apple-health-ingest endpoint
#   APPLE_HEALTH_USER_ID   # your auth.users id (single user) — ingest + XML import target
# ---------------------------------------------------------------------------
#
# Local one-time XML backfill (scripts/import-apple-health-xml.ts) needs these in
# your shell env: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, APPLE_HEALTH_USER_ID.

